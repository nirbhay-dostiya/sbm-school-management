rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn(); // Relaxed for environment constraints
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData(request.auth.uid).role == 'admin';
    }

    function isFaculty() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData(request.auth.uid).role == 'faculty';
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Courses
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Enrollments
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (isOwner(resource.data.studentId) || isAdmin() || isFaculty());
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin() || isFaculty());
      allow create: if isVerified() && incoming().studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin() || isFaculty());
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin() || isFaculty());
      allow create: if isAdmin() || isFaculty();
      allow update: if isAdmin() || isFaculty();
    }

    // Library
    match /library/{bookId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Hostel
    match /hostel/{roomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Events
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFaculty();
    }

    // Forum
    match /forum/{postId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(existing().authorId) || isAdmin()) && 
                    !incoming().diff(existing()).affectedKeys().hasAny(['authorId']);
      allow delete: if isSignedIn() && (isOwner(existing().authorId) || isAdmin());
    }

    // Default Deny (at the end)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
